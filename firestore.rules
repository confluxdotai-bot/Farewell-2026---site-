rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidRegistration(data) {
      return data.id is string
        && data.name is string && data.name.size() <= 200
        && data.batch is string && data.batch.size() <= 100;
    }

    match /registrations/{registrationId} {
      allow read: if true;
      allow create, update: if isValidId(registrationId) && isValidRegistration(request.resource.data);
      allow delete: if true;
    }
  }
}
